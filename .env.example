# ============================================
# APP
# ============================================
NODE_ENV=development
PORT=3000

# Origin frontend yang diizinkan (pisah dengan koma)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# DATABASE (PostgreSQL)
# ============================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://presensi:presensi_dev_password@localhost:5432/presensi_dev?schema=public

# ============================================
# SESSION (Cookie)
# ============================================
# Generate: openssl rand -hex 32
SESSION_SECRET=GANTI_DENGAN_RANDOM_32_BYTE_HEX
SESSION_COOKIE_NAME=presensi_session
# 8 jam = 28800000 ms
SESSION_MAX_AGE_MS=28800000
SESSION_SAME_SITE=lax

# ============================================
# SECURITY
# ============================================
BCRYPT_ROUNDS=12
# Generate: openssl rand -hex 32
CSRF_SECRET=GANTI_DENGAN_RANDOM_32_BYTE_HEX

# ============================================
# UPLOAD (Surat sakit)
# ============================================
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_BYTES=5242880